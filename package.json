{
  "name": "dsh-session-merge",
  "version": "0.4.0",
  "description": "DSH 会话合并/追加：fork 克隆、全类型复制、时间窗混合、surface 折叠、JSONL 区间写入；三层校验（本地预检 / 六层深度 / 官方 open）。实测 DSH 桌面端 0.2.1-rc.5。",
  "license": "MIT",
  "author": "HCQM",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HCQM/dsh-session-merge.git"
  },
  "homepage": "https://github.com/HCQM/dsh-session-merge",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./validate-full.mjs": "./validate-full.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "validate-full.mjs",
    "deep-validate.mjs",
    "bin",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "INSTALL.md",
    "FEATURES.md",
    "CONFIG.md",
    "API.md",
    "CHANGELOG.md",
    "LICENSE",
    "session-merge-runbook.md"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "session",
    "merge",
    "context",
    "validator"
  ],
  "dsh": {
    "id": "dsh-session-merge",
    "name": "会话合并",
    "version": "0.4.0",
    "permissions": "读取会话列表与事件；写入、折叠、克隆会话",
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.1-rc.5 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "bin": {
    "dsh-session-validate": "./bin/validate.mjs"
  }
}
